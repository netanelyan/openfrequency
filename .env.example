# open-frequency: every variable the engine reads.
#
# Copy this file to $OF_HOME/.env (./private/.env by default; `npm run init-private`
# does it) and fill in what you have. Nothing here is required to run the engine:
# without keys it runs on recordings and the fake clients, and each real client
# switches on when its key is set. Never put a value in this file itself.

# ---------- where the private data lives ------------------------------------

# The private folder: packs, database, media, recordings, this .env.
# Default ./private (inside the checkout, gitignored). A relative path is resolved
# against the repository root.
OF_HOME=

# "live" (real sources, real Claude) or "recorded" (recordings only, no network).
# Default: live when ANTHROPIC_API_KEY is set, recorded otherwise.
OF_MODE=

# Force the recorded model client even in live mode ("recorded"). For testing.
OF_LLM=

# ---------- the budget -------------------------------------------------------

# The hard monthly cap in US dollars for every metered service the engine calls
# (Claude, Brave, image APIs). Zernio is a subscription and is not counted here.
# Nothing can spend past it: every paid call reserves its worst case first.
# Each account gets a share; when money runs short the weakest account drops to
# one post a day first. Default 15.
OF_BUDGET_MONTHLY_USD=

# "off" drafts with direct calls at full price instead of the Message Batches API
# (half price, answers within minutes to hours). Default: batches when Claude is live.
OF_BATCH=

# Who the engine says it is when it reads a source. Wikimedia and SEC ask for a
# contact: "open-frequency/0.1 (+https://your.site; you@your.site)".
OF_USER_AGENT=

# EDGAR (SEC filings) refuses a reader without a name and an email in its
# User-Agent: "Your Name you@your.site". Only sources that ask for it use it.
SEC_USER_AGENT=

# ---------- Claude (drafting, the bot-score review, source scoring) ---------

# console.anthropic.com > API keys. Without it every drafting call is answered
# from recordings, and the reviewer is the offline heuristic.
ANTHROPIC_API_KEY=

# Only for a key that is not scoped to a workspace (the API then refuses every
# request without one): console.anthropic.com > Settings > Workspaces, the ID
# (wrkspc_...). Leave empty for an ordinary workspace key.
ANTHROPIC_WORKSPACE_ID=

# The model for drafting the outline and the slides. Default claude-sonnet-5-5.
MODEL_DRAFT=

# The model that rewrites a text the reviewer flagged. Default: MODEL_DRAFT.
MODEL_REWRITE=

# The model for the "does this sound like a bot, does it say more than its facts" review. Default claude-sonnet-5-5 (docs/costs.md says why not Haiku).
MODEL_REVIEW=

# The model for sorting and scoring: sources in onboarding, a trend's format. Default claude-haiku-5-5.
MODEL_JUDGE=

# ---------- publishing -------------------------------------------------------

# zernio.com > Settings > API. Publishing and analytics. Without it every account
# publishes with the dry publisher (to disk), whatever its pack says.
ZERNIO_API_KEY=

# Must be "live" for any post to leave through Zernio. Anything else, including
# empty, keeps every account on the dry publisher. A deliberate second switch.
PUBLISH_MODE=

# Zernio's API base. Leave empty for https://zernio.com/api/v1.
ZERNIO_BASE=

# The public https address that serves $OF_HOME/data/public (Zernio and Instagram
# fetch slides by URL). On the VPS this is a Caddy file_server, e.g. https://media.example.com
MEDIA_PUBLIC_BASE_URL=

# ---------- Instagram, directly through Meta's Graph API ---------------------
# For a pack whose pack.json says "publishers": { "instagram": "instagram" }.
# The README's "Instagram" section walks through the Meta app and the tokens.

# Each pack's token, in the variable its pack.json names (instagram.tokenEnv);
# the default name is IG_TOKEN_ and the pack id in capitals, dashes as underscores.
# A Page access token (Facebook Login) or a long-lived Instagram token. Make one
# with `npm run instagram:token -- --pack <id> --short <token>`.
IG_TOKEN_EXAMPLE=

# The Meta app's id and secret (developers.facebook.com > your app > App settings
# > Basic). Used to turn a short token into a long one and to read when a token
# and its data access expire. Never sent anywhere but Meta.
META_APP_ID=

# The Meta app's secret, from the same page.
META_APP_SECRET=

# The Graph API version. Leave empty for v25.0.
GRAPH_API_VERSION=

# ---------- discovery (new accounts, trends) ---------------------------------

# brave.com/search/api: finding authority sites for a new account. $5 per 1,000 queries.
BRAVE_API_KEY=

# console.cloud.google.com: a key restricted to YouTube Data API v3. Shorts that
# work now, with their real view counts. Free, quota only.
YOUTUBE_API_KEY=

# ---------- images -----------------------------------------------------------

# pexels.com/api: free key. Photographs under the Pexels License.
PEXELS_API_KEY=

# unsplash.com/developers: an app's Access Key. Photographs under the Unsplash License.
UNSPLASH_ACCESS_KEY=

# ---------- the website ------------------------------------------------------

# Port the website listens on, on 127.0.0.1 only. Default 4700.
PORT=

# The public name Caddy serves the website under (e.g. teder.example.com).
# When set, the site insists on HTTPS through the proxy and on a password.
PUBLIC_HOST=

# A long random string that signs the login cookie. Changing it logs everyone out.
SESSION_SECRET=

# The first user, created on first start when no user exists yet. After that,
# users live in the database (npm run user:add) and these are ignored.
OF_ADMIN_USER=

# The first user's password, at least 12 characters. Remove it from .env after the first start.
OF_ADMIN_PASSWORD=
