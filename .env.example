# open-frequency: every variable the engine reads.
#
# Copy this file to $OF_HOME/.env (./private/.env by default; `npm run init-private`
# does it) and fill in what you have. Nothing here is required to run the engine:
# without keys it runs on recordings and the fake clients, and each real client
# switches on when its key is set. Never put a value in this file itself.

# ---------- where the private data lives ------------------------------------

# The private folder: packs, database, media, recordings, this .env.
# Default ./private (inside the checkout, gitignored). A relative path is resolved
# against the repository root.
OF_HOME=

# "live" (real sources, real Claude) or "recorded" (recordings only, no network).
# Default: live when ANTHROPIC_API_KEY is set, recorded otherwise.
OF_MODE=

# Force the recorded model client even in live mode ("recorded"). For testing.
OF_LLM=

# ---------- Claude (drafting, the bot-score review, source scoring) ---------

# console.anthropic.com > API keys. Without it every drafting call is answered
# from recordings, and the reviewer is the offline heuristic.
ANTHROPIC_API_KEY=

# The model for drafting the outline and the slides. Default claude-opus-5-5.
MODEL_DRAFT=

# The model for the "does this sound like a bot" review and its rewrites. Default claude-opus-5-5.
MODEL_REVIEW=

# The model for judgements: scoring sources in onboarding, reading a trend's format. Default claude-opus-5-5.
MODEL_JUDGE=

# ---------- publishing -------------------------------------------------------

# zernio.com > Settings > API. Publishing and analytics. Without it every account
# publishes with the dry publisher (to disk), whatever its pack says.
ZERNIO_API_KEY=

# Must be "live" for any post to leave through Zernio. Anything else, including
# empty, keeps every account on the dry publisher. A deliberate second switch.
PUBLISH_MODE=

# Zernio's API base. Leave empty for https://zernio.com/api/v1.
ZERNIO_BASE=

# The public https address that serves $OF_HOME/data/public (Zernio fetches slides
# by URL). On the VPS this is a Caddy file_server, e.g. https://media.example.com
MEDIA_PUBLIC_BASE_URL=

# ---------- discovery (new accounts, trends) ---------------------------------

# brave.com/search/api: finding authority sites for a new account. $5 per 1,000 queries.
BRAVE_API_KEY=

# console.cloud.google.com: a key restricted to YouTube Data API v3. Shorts that
# work now, with their real view counts. Free, quota only.
YOUTUBE_API_KEY=

# ---------- images -----------------------------------------------------------

# pexels.com/api: free key. Photographs under the Pexels License.
PEXELS_API_KEY=

# unsplash.com/developers: an app's Access Key. Photographs under the Unsplash License.
UNSPLASH_ACCESS_KEY=

# ---------- the website ------------------------------------------------------

# Port the website listens on, on 127.0.0.1 only. Default 4700.
PORT=

# The public name Caddy serves the website under (e.g. teder.example.com).
# When set, the site insists on HTTPS through the proxy and on a password.
PUBLIC_HOST=

# A long random string that signs the login cookie. Changing it logs everyone out.
SESSION_SECRET=

# The first user, created on first start when no user exists yet. After that,
# users live in the database (npm run user:add) and these are ignored.
OF_ADMIN_USER=

# The first user's password, at least 12 characters. Remove it from .env after the first start.
OF_ADMIN_PASSWORD=
